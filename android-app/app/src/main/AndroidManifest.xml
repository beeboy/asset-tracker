<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 시세·동기화·검색을 받는다 (아이폰은 따로 허락이 필요 없다) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 동네 날씨: 대략 위치만 (거절해도 서울 날씨로 동작) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 미니 게임 부딪힘·벽돌 깸 진동 (iOS UIFeedbackGenerator 자리) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 아침 한 줄·본전 도달 등 기기 안 알림 (안드로이드 13+ 는 허락을 묻는다) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 기기를 다시 켜면 예약한 알림을 다시 건다 (안드로이드 알람은 재부팅하면 사라진다) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:localeConfig="@xml/locales_config"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_star"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Naeilo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode|fontScale"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <!-- 위젯·알림 밖에서 여는 주소 naeilo://unlock·shelter·read/3·subscribe (iOS onOpenURL) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="naeilo" />
            </intent-filter>
        </activity>
        <!-- 앱 아이콘 바꾸기 (설정 > 앱 아이콘): 런처 별칭 하나만 켠다. 기본은 내일의 별 -->
        <activity-alias android:name=".IconDefault" android:targetActivity=".MainActivity" android:exported="true" android:enabled="true" android:icon="@drawable/ic_launcher_star">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".Icon_seri" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false" android:icon="@drawable/ic_launcher_seri">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".Icon_sio" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false" android:icon="@drawable/ic_launcher_sio">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".Icon_seonbae" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false" android:icon="@drawable/ic_launcher_seonbae">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".Icon_ir" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false" android:icon="@drawable/ic_launcher_ir">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".Icon_sua" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false" android:icon="@drawable/ic_launcher_sua">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <!-- 미션 위젯 공유 이미지를 다른 앱에 건넨다 -->
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <!-- 예약 알림이 울릴 때·기기를 다시 켤 때·앱을 새로 깔았을 때 -->
        <receiver android:name=".data.NotifyReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
            <!-- 앱 언어가 바뀌면 앱을 새로 띄우는 잠깐 화면 (따로 된 프로세스) -->
        <activity
            android:name=".RestartActivity"
            android:process=":restart"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
